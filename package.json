{
  "name": "gentle-shell-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @gentle-shell/desktop dev",
    "dev:desktop": "pnpm --filter @gentle-shell/desktop tauri dev",
    "dev:bridge": "pnpm --filter @gentle-shell/bridge dev",
    "build:bridge": "pnpm --filter @gentle-shell/bridge build",
    "typecheck": "pnpm -r typecheck"
  }
}
