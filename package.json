{
  "name": "gentle-shell-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @gentle-shell/desktop dev",
    "dev:bridge": "node --experimental-strip-types packages/bridge/src/main.ts --port 7787 --token dev",
    "dev:desktop": "pnpm --filter @gentle-shell/desktop tauri dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  }
}
